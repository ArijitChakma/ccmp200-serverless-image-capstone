{
  "QueryLanguage": "JSONPath",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:213449029907:function:capstone-resize-image",
        "Payload.$": "$"
      },
      "Next": "ResizeSuccessful",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ImageProcessingFailed"
        }
      ]
    },
    "ResizeSuccessful": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.success",
          "BooleanEquals": true,
          "Next": "ImageProcessed"
        }
      ],
      "Default": "ImageProcessingFailed"
    },
    "ImageProcessed": {
      "Type": "Succeed"
    },
    "ImageProcessingFailed": {
      "Type": "Fail",
      "Error": "ImageProcessingFailed",
      "Cause": "The resize Lambda could not create a thumbnail. Check ResizeImage in the execution history."
    }
  }
}
